var first_loading = new Array;
function do_load(mode) {
    var id = 'body';
    if (mode == 'on') {
        pageSize = new Array;
        pageSize['w'] = $(window).width();
        pageSize['h'] = $(document).height();
        pageSize['t'] = 0;
        pageSize['l'] = 0;
        m_app = 'body';

        if (!first_loading[id]) {
            $(m_app).append('<div id="lightbox-overlay_' + id + '" class="overal" onclick="return OveralClick();"><div></div></div>');
            overlay = $('#lightbox-overlay_' + id);
            first_loading[id] = 'ok';
        }
        else {
            overlay = $('#lightbox-overlay_' + id);
        }

        overlay.css({
            position: 'absolute',
            display: 'none',
            top: pageSize.t,
            left: pageSize.l,
            zIndex: 11000,
            opacity: 0,
            height: pageSize.h + 'px',
            width: pageSize.w + 'px'
        }).fadeTo(1, 0.6).animate({ height: 'show' }, "slow");

        $('#lightbox-overlay_' + id + ' div').css({
            left: $(window).width() / 2 - 150,
        });
    }
    else {
        $('#lightbox-overlay_' + id).animate({ height: 'hide', opacity: 'hide' }, "slow");
    }
}
$(document).ready(function () {
    $(window).resize(function () {
        pageSize = new Array;
        pageSize['w'] = $(window).width();
        pageSize['h'] = $(document).height();
        pageSize['t'] = 0;
        pageSize['l'] = 0;

        $(".overal").css({
            top: pageSize.t,
            left: pageSize.l,
            height: pageSize.h + 'px',
            width: pageSize.w + 'px'
        });
    });
});/*!
