//===================================================================
function change(obj) {
    flag = !flag;
    obj.focus();
}
//===================================================================
function convert(fld, e) {
    if (flag) {
        if (msie) {
            k = event.keyCode;
            if (k > 31 && k < 128) {
                h = s.charCodeAt(k - 32);
                event.keyCode = h;
                return true;
            }
        }
        if (gecko) {
            k = e.which;
            if (k > 31 && k < 128) {
                h = s.charCodeAt(k - 32);
                fld.value = fld.value + String.fromCharCode(h);
                return false;
            }
            else {
                return true;
            }
        }
        if (opera) {
            k = event.keyCode;
            if (k > 31 && k < 128) {
                h = s.charCodeAt(k - 32);
                fld.value = fld.value + String.fromCharCode(h);
                return false;
            }
            else {
                return true;
            }
        }
    }
}
function convertEn(fld, e) {
    if (flag) {
        if (msie) {
            k = event.keyCode;
            if (k > 31 && k < 128) {
                alert('لطفا حروف انگلیسی وارد کنید.');
                return false;
            }
        }
        if (gecko) {
            k = e.which;
            if ((k > 31 && k < 128) || k == 0 || k == 8 || k == 13) {
                return true;
            }
            else {
                alert('لطفا حروف انگلیسی وارد کنید.');
                return false;
            }
        }
        if (opera) {
            k = event.keyCode;
            if (k > 31 && k < 128) {
                return true;
            }
            else {
                alert('لطفا حروف انگلیسی وارد کنید.');
                return false;
            }
        }
    }
}
//===================================================================
function LangFar(myobj) {
    myobj.style.textAlign = "right";
    myobj.style.direction = "rtl";
    myobj.focus();
    lang = 1;
}
//===================================================================
function LangEng(myobj) {
    myobj.style.textAlign = "left";
    myobj.style.direction = "ltr";
    myobj.focus();
    lang = 0;
}
